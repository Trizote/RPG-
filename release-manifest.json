  "added": [
    "name: Update Release Manifest",
    "paths-ignore:",
    "- \"release-manifest.json\"",
    "update-manifest:",
    "- name: Checkout repository",
    "- name: Generate release-manifest.json from changes",
    "const fs = require(\"fs\");",
    "let diffText = \"\";",
    "diffText = execSync(\"git diff HEAD~1 HEAD -- . \\\":!release-manifest.json\\\"\", { encoding: \"utf8\" });",
    "} catch {",
    "diffText = execSync(\"git show --format= -- . \\\":!release-manifest.json\\\"\", { encoding: \"utf8\" });",
    "}",
    "const addedLines = [];",
    "for (const line of diffText.split(\"\\n\")) {",
    "if (line.startsWith(\"+\") && !line.startsWith(\"+++\")) {",
    "const clean = line.slice(1).trim();",
    "if (clean) addedLines.push(clean);",
    "const changedFiles = execSync(\"git diff --name-only HEAD~1 HEAD -- . \\\":!release-manifest.json\\\"\", { encoding: \"utf8\" })",
    ".split(\"\\n\")",
    ".map((s) => s.trim())",
    ".filter(Boolean);",
    "const commitMsg = execSync(\"git log -1 --pretty=%s\", { encoding: \"utf8\" }).trim();",
    "const shaShort = execSync(\"git rev-parse --short HEAD\", { encoding: \"utf8\" }).trim();",
    "const updatedAt = new Date().toISOString();",
    "version: shaShort,",
    "updatedAt,",
    "title: commitMsg || `Atualização ${shaShort}`,",
    "files: changedFiles,",
    "added: addedLines.slice(0, 60)",
    "- name: Commit release-manifest.json",
    "if ! git diff --staged --quiet; then",
    "git commit -m \"chore: update release-manifest.json [skip ci]\"",
